# config-dotenv example .env
#
# DB_HOST is the only variable actually set here -- DB_PORT is intentionally
# ABSENT to prove PropertyBuilder.Default() kicks in (see config.go, which
# sets .Default(5432) for DB_PORT).
DB_HOST=db.internal

# Interpolation: DB_URL is built from DB_HOST above, showing dotenvx-style
# ${VAR} interpolation working end-to-end.
DB_URL="postgres://${DB_HOST}/app"
